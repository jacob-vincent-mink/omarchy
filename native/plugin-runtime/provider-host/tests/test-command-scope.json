{
  "commands": [
  {
    "command": "printf",
    "executable": "/usr/bin/printf",
    "timeoutMs": 500,
    "stdoutBytes": 1024,
    "stderrBytes": 1024,
    "accountHome": false,
    "environment": {},
    "rules": [
      [
        {"exact": "%s"},
        {"regex": "[a-z]{1,8}"}
      ]
    ]
  },
  {
    "command": "sleep",
    "executable": "/usr/bin/sleep",
    "timeoutMs": 50,
    "stdoutBytes": 1024,
    "stderrBytes": 1024,
    "accountHome": false,
    "environment": {},
    "rules": [
      [
        {"regex": "[1-9][0-9]*"}
      ]
    ]
  },
  {
    "command": "yes",
    "executable": "/usr/bin/yes",
    "timeoutMs": 500,
    "stdoutBytes": 256,
    "stderrBytes": 256,
    "accountHome": false,
    "environment": {},
    "rules": [
      []
    ]
  }
  ]
}
