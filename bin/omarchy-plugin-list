#!/bin/bash

# omarchy:summary=List discovered shell plugins
# omarchy:group=plugin
# omarchy:args=[--json]

set -euo pipefail

json="false"

while (( $# > 0 )); do
  case "$1" in
  --json)
    json="true"
    ;;
  -h | --help)
    echo "Usage: omarchy plugin list [--json]"
    exit 0
    ;;
  *)
    echo "omarchy-plugin-list: unknown option: $1" >&2
    exit 1
    ;;
  esac
  shift
done

catalog=$(omarchy-plugin-catalog)
if jq -e 'any(.[]; .sandboxed)' <<<"$catalog" >/dev/null; then
  # The catalog remains usable with no running shell. Approval comes from
  # Rust, while enabled continues to describe shell activation, not grants.
  shell_plugins=$(omarchy-shell shell listPlugins 2>/dev/null) || shell_plugins='[]'
  native=$(printf '%s' '{"operation":"list"}' | omarchy-plugin-runtime)
  plugins=$(jq -cn --argjson catalog "$catalog" --argjson live "$shell_plugins" --argjson native "$native" '
    $catalog | map(. as $entry |
      (first($live[] | select(.id == $entry.id)) // {}) as $running |
      (first($native[] | select(.id == $entry.id)) // {}) as $approval |
      ($entry + {enabled: null} + $running) |
      if $entry.sandboxed then . + {
        enabled: ($running.enabled // false),
        approved: ($approval.approved // false),
        revision: ($approval.revision // null),
        grants: ($approval.grants // {}),
        error: ($approval.error // null)
      } else . end)
  ')
else
  plugins=$(omarchy-shell shell listPlugins)
fi

if [[ $json == "true" ]]; then
  printf '%s\n' "$plugins"
  exit 0
fi

jq -r '
  .[] |
  [ .id,
    (if .error then "error"
      elif .enabled then "enabled"
      elif .approved then "approved"
      elif .enabled == null then "unknown"
      else "disabled" end),
    (if .firstParty then "first-party" else "third-party" end),
    ((.kinds // []) | join(",")),
    (.name // "")
  ] | @tsv
' <<<"$plugins" | awk -F '\t' '
  BEGIN { printf "%-32s %-9s %-11s %-18s %s\n", "ID", "STATE", "SOURCE", "KINDS", "NAME" }
  { printf "%-32s %-9s %-11s %-18s %s\n", $1, $2, $3, $4, $5 }
'
