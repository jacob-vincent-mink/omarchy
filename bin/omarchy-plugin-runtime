#!/bin/bash

# omarchy:summary=Call the native sandbox plugin management backend
# omarchy:hidden=true

# JSON on stdin/stdout; only trusted commands and the future review UI call it.
# Overrides are for explicitly built development runtimes, not plugin manifests.
set -euo pipefail

runtime="${OMARCHY_PLUGIN_HOST:-$OMARCHY_PATH/lib/omarchy-plugin-host}"
store="${OMARCHY_PLUGIN_STORE:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugin-host}"

if [[ $runtime != /* || ! -x $runtime ]]; then
  echo "omarchy-plugin-runtime: native sandbox runtime is not installed; set OMARCHY_PLUGIN_HOST to an explicitly built development binary" >&2
  exit 1
fi
[[ $store == /* ]] || { echo "omarchy-plugin-runtime: store path must be absolute" >&2; exit 1; }

request=$(head -c 65537)
(( ${#request} <= 65536 )) || { echo "omarchy-plugin-runtime: request too large" >&2; exit 1; }
if [[ $(jq -r '.operation' <<<"$request") == "import" ]]; then
  mkdir -p "$(dirname "$store")"
fi
response=$(printf '%s' "$request" | "$runtime" --manage "$store")
if jq -e '.ok == true' <<<"$response" >/dev/null; then
  jq -c '.value' <<<"$response"
else
  jq -r '.error // "native management failed"' <<<"$response" >&2
  exit 1
fi
