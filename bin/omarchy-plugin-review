#!/bin/bash

# omarchy:summary=Snapshot an installed Ward plugin and review its requested access
# omarchy:args=<id> [--json|--ui]
# omarchy:examples=omarchy plugin review acme.weather

set -euo pipefail

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: omarchy plugin review <id> [--json|--ui]"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || { echo "omarchy-plugin-review: plugin id is required" >&2; exit 1; }
shift
if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != "--json" && $1 != "--ui" ]]; }; then
  echo "omarchy-plugin-review: expected --json or --ui after the id" >&2
  exit 1
fi

plugin=$(omarchy-plugin-catalog | jq -ce --arg id "$id" 'map(select(.id == $id))[0] // empty') || {
  echo "omarchy-plugin-review: plugin '$id' is not installed; use omarchy plugin add first" >&2
  exit 1
}
jq -e '.sandbox != null' <<<"$plugin" >/dev/null || {
  echo "omarchy-plugin-review: '$id' has no sandbox entry point; it uses the existing trusted in-process workflow" >&2
  exit 1
}
source_dir=$(jq -r '.sourceDir' <<<"$plugin")
if [[ ${1:-} == "--ui" ]]; then
  payload=$(jq -cn --arg id "$id" '{id: $id}')
  result=$(omarchy-shell shell summon omarchy.plugin-review "$payload")
  [[ $result == "ok" ]] || { echo "omarchy-plugin-review: review panel is unavailable; restart the updated shell" >&2; exit 1; }
  exit 0
fi
review=$(jq -cn --arg path "$source_dir" '{operation: "import", path: $path}' | omarchy-ward-runtime)

if [[ ${1:-} == "--json" ]]; then
  printf '%s\n' "$review"
else
  jq -r '
    def requirement: if type == "object" and .required == true then "required" else "optional" end;
    .requests as $requests |
    "\(.name) (\(.id)) — \(.version)",
    "Revision: \(.revision)", "", "Requested access:",
    (($requests.filesystem // [])[] |
      "  Folder \(.name): \(if .access == "readwrite" then "read-write" else "read-only" end), \(requirement) (you select the folder)"),
    (($requests.http // {}) | to_entries[] |
      "  HTTP \(.key): \(.value.scope.method) \(.value.scope.origin)\(.value.scope.path)\(if .value.scope.subtree then " (subtree)" else "" end), \(.value | requirement)",
      "    Query: \(.value.scope.query | tojson)", "    JSON body: \(.value.scope.body | tojson)"),
    (($requests.exec // {}) | to_entries[] |
      "  Host executable \(.key): \(.value.executable)",
      "    Required leaves: \(.value.required | tojson)",
      "    Command tree: \(.value.tree | tojson)",
      "    Uses existing host accounts, files and network; completed effects cannot be undone by revocation."),
    ([
      {key: "network", label: "Network, including local services"},
      {key: "media", label: "One selected media player"},
      {key: "notifications", label: "Text-only notifications"},
      {key: "openUrls", label: "Open HTTP(S) links in browser sessions"},
      {key: "storage", label: "Private persistent storage; saved data remains after revocation"}
    ][] | . as $capability | $requests[$capability.key] | select(. != null and . != false) |
      "  \($capability.label) (\(requirement))"),
    ($requests.settings as $settings | ["read", "write"][] as $operation |
      ($settings[$operation] // [])[] | "  Own setting \(.): \($operation), \($settings | requirement)"),
    (if (($requests.filesystem // []) | length) == 0
      and (($requests.http // {}) | length) == 0
      and (($requests.exec // {}) | length) == 0
      and (($requests.settings.read // []) | length) == 0 and (($requests.settings.write // []) | length) == 0
      and ([$requests.network, $requests.media, $requests.notifications, $requests.openUrls, $requests.storage] | any(. != null and . != false) | not)
      then "  None" else empty end),
    "", "No plugin code was run. Requests are not grants.",
    "Approve this exact revision with:",
    "  omarchy plugin approve \(.id) --revision \(.revision)"
  ' <<<"$review"
fi
